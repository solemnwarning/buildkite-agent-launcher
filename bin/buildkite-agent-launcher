use strict;
use warnings;

package App::BuildkiteAgentLauncher;

use AnyEvent;
use AnyEvent::HTTP;
use JSON;
use YAML::Tiny;

my $BUILDKITE_ORGANISATION;
my $BUILDKITE_API_TOKEN;
my $BUILDKITE_POLL_INTERVAL = 300;

my $WEBHOOK_ADDRESS = "0.0.0.0";
my $WEBHOOK_PORT;
my $WEBHOOK_TOKEN;
my $WEBHOOK_POLL_DELAY = 3;

my @AGENTS;

my $poll_timer;
my $poll_running = 0;
my $httpd;

sub main
{
	die "Usage: $0 <config.yaml>\n" unless((scalar @ARGV) == 1);
	
	load_config($ARGV[0]);
	
	if(defined $WEBHOOK_PORT)
	{
		$httpd = App::BuildkiteAgentLauncher::WebhookServer->new(
			$WEBHOOK_TOKEN,
			\&poll_soon,
			
			host => $WEBHOOK_ADDRESS,
			port => $WEBHOOK_PORT,
		);
	}
	
	my $exit_cv = AnyEvent->condvar();
	
	local $SIG{"TERM"} = sub
	{
		$exit_cv->send();
	};
	
	# Do initial poll and schedule next one.
	poll_now();
	
	# Wait for termination signal.
	$exit_cv->recv();
	
	$poll_timer = undef;
	$httpd      = undef;
}

sub load_config
{
	my ($filename) = @_;
	
	my $yaml = YAML::Tiny->read($filename);
	my $doc  = $yaml->[0];
	
	$BUILDKITE_ORGANISATION  = $doc->{"buildkite organisation"};
	$BUILDKITE_API_TOKEN     = $doc->{"buildkite api token"};
	$BUILDKITE_POLL_INTERVAL = $doc->{"buildkite poll interval"} // $BUILDKITE_POLL_INTERVAL;
	
	die "No 'buildkite organisation' specified in $filename\n"
		unless(defined($BUILDKITE_ORGANISATION));
	
	die "No 'buildkite api token' specified in $filename\n"
		unless(defined($BUILDKITE_API_TOKEN));
	
	die "Invalid 'buildkite poll interval' specified in $filename\n"
		unless($BUILDKITE_POLL_INTERVAL =~ m/^[1-9][0-9]*$/);
	
	$WEBHOOK_ADDRESS    = $doc->{"webhook listen address"} // $WEBHOOK_ADDRESS;
	$WEBHOOK_PORT       = $doc->{"webhook listen port"}    // $WEBHOOK_PORT;
	$WEBHOOK_TOKEN      = $doc->{"webhook token"}          // $WEBHOOK_TOKEN;
	$WEBHOOK_POLL_DELAY = $doc->{"webhook poll delay"}     // $WEBHOOK_POLL_DELAY;
	
	die "Invalid 'webhook poll delay' specified in $filename\n"
		unless($WEBHOOK_POLL_DELAY =~ m/^[1-9][0-9]*$/);
	
	die "Invalid 'webhook listen port' specified in $filename\n"
		if(defined($WEBHOOK_PORT) && ($WEBHOOK_PORT !~ m/^[1-9][0-9]*$/ || $WEBHOOK_PORT >= 65536));
	
	die "No 'agents' specified in $filename\n"
		unless(defined($doc->{agents}) && ref($doc->{agents}) eq "ARRAY");
	
	foreach my $agent(@{ $doc->{agents} })
	{
		die "Invalid agent definition in 'agents' in $filename\n"
			unless(ref($agent) eq "HASH");
		
		my %options = ();
		
		if(defined $agent->{"meta-data"})
		{
			# Buildkite 2.x called tags "agent meta-data"
			
			warn "Deprecated 'meta-data' parameter specified in $filename - use 'tags' instead\n";
			
			if(defined $agent->{"tags"})
			{
				die "'tags' and 'meta-data' cannot be specified together on the same agent in $filename\n";
			}
			
			$options{tags} = [ split(m/,/, $agent->{"meta-data"}) ];
		}
		elsif(defined $agent->{"tags"})
		{
			$options{tags} = [ split(m/,/, $agent->{"tags"}) ];
		}
		else{
			$options{tags} = [ "queue=default" ];
		}
		
		if(defined $agent->{"count command"})
		{
			if(defined $agent->{"check command"})
			{
				die "'check command' and 'count command' cannot be specified together on the same agent in $filename\n";
			}
			
			if(defined $agent->{"spawn"})
			{
				die "'spawn' and 'count command' cannot be specified together on the same agent in $filename\n";
			}
			
			$options{count_command} = $agent->{"count command"};
			
			if(defined $agent->{"max instances"})
			{
				$options{max_instances} = $agent->{"max instances"};
			}
			
			$options{spawn_per_instance} = $agent->{"spawn per instance"} // 1;
		}
		elsif(defined $agent->{"check command"})
		{
			if(defined $agent->{"max instances"})
			{
				die "'check command' and 'max instances' cannot be specified together on the same agent in $filename\n";
			}
			
			if(defined $agent->{"spawn per instance"})
			{
				die "'check command' and 'spawn per instance' cannot be specified together on the same agent in $filename\n";
			}
			
			$options{check_command} = $agent->{"check command"};
			
			$options{spawn} = $agent->{"spawn"} // 1;
		}
		else{
			die "No 'count command' or 'check command' specified in agent definition in $filename\n";
		}
		
		die "No 'launch command' specified in agent definition in $filename\n"
			unless(defined($agent->{"launch command"}) && ref($agent->{"launch command"}) eq "");
		
		$options{launch_command} = $agent->{"launch command"};
		
		if(defined $options{check_command})
		{
			push(@AGENTS, App::BuildkiteAgentLauncher::SingleAgent->new(%options));
		}
		else{
			push(@AGENTS, App::BuildkiteAgentLauncher::MultiAgent->new(%options));
		}
	}
}

sub poll_now
{
	if($poll_running)
	{
		poll_soon();
		return;
	}
	
	$poll_timer   = AnyEvent->timer(after => $BUILDKITE_POLL_INTERVAL, cb => \&poll_now);
	$poll_running = 1;
	
	http_request(
		"GET", "https://api.buildkite.com/v2/organizations/${BUILDKITE_ORGANISATION}/builds?state[]=scheduled&state[]=running&state[]=failing",
		headers => { "Authorization" => "Bearer $BUILDKITE_API_TOKEN" },
		sub
		{
			my ($body, $hdr) = @_;
			
			if($hdr->{Status} == 200)
			{
				my @builds;
				eval { @builds = @{ decode_json($body) }; };
				
				if($@)
				{
					print STDERR "Error decoding JSON response from Buildkite API: $@\n";
				}
				else{
					poll_finish(@builds);
				}
			}
			else{
				print STDERR "Got HTTP code ".$hdr->{Status}." from Buildkite API\n${body}\n";
			}
			
			$poll_running = 0;
		});
}

sub poll_finish
{
	my @builds = @_;
	
	# Extract all running/scheduled jobs ("steps") from the list of builds, since
	# they're what actually get allocated to agents.
	my @jobs = grep { $_->{type} eq "script" && ($_->{state} eq "scheduled" || $_->{state} eq "running") }
		map { @{ $_->{jobs} } } @builds;
	
	# Clear any counters from previous poll - we will re-learn the number of currently running
	# instances and assign jobs from scratch.
	foreach my $agent(@AGENTS)
	{
		$agent->reset();
	}
	
	JOB: foreach my $job(@jobs)
	{
		# First, we check if any agents are already running that satisfy the job.
		
		foreach my $agent(@AGENTS)
		{
			if($agent->satisfies_query_rules(@{ $job->{agent_query_rules} })
				&& !$agent->failed()
				&& $agent->assign_job())
			{
				next JOB;
			}
		}
		
		# Next we try to find an agent we can start/scale to satisfy the job.
		
		foreach my $agent(@AGENTS)
		{
			if($agent->satisfies_query_rules(@{ $job->{agent_query_rules} })
				&& !$agent->failed()
				&& $agent->increase_spawn()
				&& $agent->assign_job())
			{
				next JOB;
			}
		}
	}
	
	$poll_running = 0;
}

sub poll_soon
{
	$poll_timer = AnyEvent->timer(after => $WEBHOOK_POLL_DELAY, cb => \&poll_now);
}

package App::BuildkiteAgentLauncher::WebhookServer;

use AnyEvent::HTTPD;

sub new
{
	my ($class, $token, $callback, %httpd_options) = @_;
	
	my $httpd = AnyEvent::HTTPD->new(%httpd_options);
	
	$httpd->reg_cb ("/" => sub
	{
		my ($httpd, $req) = @_;
		
		# Don't fall through to default handler.
		$httpd->stop_request;
		
		if(defined $token)
		{
			my $req_token = $req->headers()->{"x-buildkite-token"} // "";
			
			if($req_token ne $token)
			{
				$req->respond([
					403, "Forbidden",
					{ "Content-Type" => "text/plain" },
					"Forbidden\n"]);
				
				return;
			}
		}
		
		$callback->();
		
		$req->respond([
			200, "OK",
			{ "Content-Type" => "text/plain" },
			"OK\n"]);
	});
	
	$httpd->reg_cb ("" => sub
	{
		my ($httpd, $req) = @_;
		
		$req->respond([
			404, "Not Found",
			{ "Content-Type" => "text/plain" },
			"Not Found\n"]);
	});
	
	return bless({ httpd => $httpd }, $class);
}

sub port
{
	my ($self) = @_;
	return $self->{httpd}->port();
}

package App::BuildkiteAgentLauncher::Agent;

use Carp qw(confess);
use List::Compare;
use POSIX qw(WIFEXITED WEXITSTATUS WIFSIGNALED WTERMSIG);

sub new
{
	my ($class, %options) = @_;
	
	my $self = bless({
		tags           => ($options{tags}           // confess("Required option 'tags' missing\n")),
		launch_command => ($options{launch_command} // confess("Required option 'launch_command' missing\n")),
		
		failed       => 0,
		current_jobs => 0,
	}, $class);
	
	return $self;
}

sub tags
{
	my ($self) = @_;
	return @{ $self->{tags} };
}

sub satisfies_query_rules
{
	my ($self, @query_rules) = @_;
	
	return List::Compare->new(\@query_rules, $self->{tags})->is_LsubsetR();
}

sub failed
{
	my ($self) = @_;
	return $self->{failed};
}

sub reset
{
	my ($self) = @_;
	
	$self->{failed}       = 0;
	$self->{current_jobs} = 0;
	
	return;
}

sub _launch
{
	my ($self) = @_;
	
	print "Running command ", $self->{launch_command}, "\n";
	my $status = system($self->{launch_command});
	
	if(WIFEXITED($status) && WEXITSTATUS($status) == 0)
	{
		# Agent launched successfully.
		return 1;
	}
	elsif(WIFEXITED($status) && WEXITSTATUS($status) == 75) # EX_TEMPFAIL
	{
		# Temporary failure.
		# Count this as a success so we don't kick off unwanted agents.
		
		print STDERR "Command returned status 75 (temporary failure)\n";
		
		return 1;
	}
	elsif(WIFEXITED($status))
	{
		print STDERR "Command returned status ", WEXITSTATUS($status), "\n";
		$self->{failed} = 1;
		
		return 0;
	}
	elsif(WIFSIGNALED($status))
	{
		print STDERR "Command killed by signal ", WTERMSIG($status), "\n";
		$self->{failed} = 1;
		
		return 0;
	}
	
	# Unreachable(?)
	return 0;
}

sub assign_job
{
	my ($self) = @_;
	
	if($self->{current_jobs} < $self->current_spawn())
	{
		$self->{current_jobs} += 1;
		return 1;
	}
	else{
		return 0;
	}
}

package App::BuildkiteAgentLauncher::SingleAgent;
use base qw(App::BuildkiteAgentLauncher::Agent);

use Carp qw(confess);
use POSIX qw(WIFEXITED WEXITSTATUS WIFSIGNALED WTERMSIG);

sub new
{
	my ($class, %options) = @_;
	
	my $self = $class->SUPER::new(%options);
	
	$self->{check_command} = $options{check_command} // confess("Required option 'check_command' missing\n");
	$self->{spawn}         = $options{spawn}         // confess("Required option 'spawn' missing\n");
	
	$self->{running} = undef;
	
	return $self;
}

sub reset
{
	my ($self) = @_;
	
	$self->{running} = undef;
	
	$self->SUPER::reset();
	
	return;
}

sub current_spawn
{
	my ($self) = @_;
	
	unless(defined $self->{running})
	{
		print "Running command ", $self->{check_command}, "\n";
		
		my $status = system($self->{check_command});
		
		if(WIFEXITED($status))
		{
			my $es = WEXITSTATUS($status);
			
			if($es == 0)
			{
				print STDERR "Command returned status $es (running)\n";
				$self->{running} = 1;
			}
			elsif($es == 1)
			{
				print STDERR "Command returned status $es (not running)\n";
				$self->{running} = 0;
			}
			else{
				print STDERR "Command returned status $es (error)\n";
				$self->{failed} = 1;
				$self->{running} = 0;
			}
		}
		elsif(WIFSIGNALED($status))
		{
			print STDERR "Command killed by signal ", WTERMSIG($status), "\n";
			$self->{failed} = 1;
			$self->{running} = 0;
		}
	}
	
	return $self->{running} ? $self->{spawn} : 0;
}

sub increase_spawn
{
	my ($self) = @_;
	
	if($self->{running})
	{
		return 0;
	}
	
	$self->{running} = $self->_launch();
	return $self->{running};
}

package App::BuildkiteAgentLauncher::MultiAgent;
use base qw(App::BuildkiteAgentLauncher::Agent);

use Carp qw(confess);
use POSIX qw(WIFEXITED WEXITSTATUS WIFSIGNALED WTERMSIG);

sub new
{
	my ($class, %options) = @_;
	
	my $self = $class->SUPER::new(%options);
	
	$self->{count_command}      = $options{count_command}      // confess("Required option 'count_command' missing\n");
	$self->{spawn_per_instance} = $options{spawn_per_instance} // confess("Required option 'spawn_per_instance' missing\n");
	$self->{max_instances}      = $options{max_instances};
	
	$self->{current_instances} = undef;
	
	return $self;
}

sub reset
{
	my ($self) = @_;
	
	$self->{current_instances} = undef;
	
	$self->SUPER::reset();
	
	return;
}

sub current_spawn
{
	my ($self) = @_;
	
	unless(defined $self->{current_instances})
	{
		print "Running command ", $self->{count_command}, "\n";
		
		my $output = `$self->{count_command}`;
		my $status = $?;
		
		if(WIFEXITED($status) && WEXITSTATUS($status) != 0)
		{
			print STDERR "Command returned status ", WEXITSTATUS($status), "\n";
			$self->{failed} = 1;
			
			return 0;
		}
		elsif(WIFSIGNALED($status))
		{
			print STDERR "Command killed by signal ", WTERMSIG($status), "\n";
			$self->{failed} = 1;
			
			return 0;
		}
		
		if($output =~ m/^([0-9]+)\r?\n?/s)
		{
			$self->{current_instances} = $1;
			
			print "Instance count: ", $self->{current_instances}, "\n";
		}
		else{
			print STDERR "Unexpected output from command (expected an integer):\n";
			
			foreach my $line(split(m/\r?\n/, $output))
			{
				chomp($line);
				print "> $line\n";
			}
			
			return 0;
		}
	}
	
	return $self->{current_instances} * $self->{spawn_per_instance};
}

sub increase_spawn
{
	my ($self) = @_;
	
	if(defined($self->{max_instances}) && $self->{current_instances} >= $self->{max_instances})
	{
		return 0;
	}
	
	if($self->_launch())
	{
		$self->{current_instances} += 1;
		return 1;
	}
	else{
		return 0;
	}
}

package main;

App::BuildkiteAgentLauncher->main() unless(caller);

1;
